# Business database (Railway Postgres) — consumed by dbt/profiles.yml via env_var()
# and by the Airflow source-availability check task.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Not read by docker-compose/dbt/superset — a convenience combined connection
# string for connecting your own tools (psql, DBeaver, etc.) to the same DB.
DATABASE_URL=

# Local platform metadata Postgres (Airflow + Superset internal state)
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=

# Airflow
AIRFLOW_UID=1000
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=
_AIRFLOW_WWW_USER_EMAIL=

# Superset
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=
